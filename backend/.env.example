# Copy this file to .env and adjust as needed.

# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key-in-production-please

# SQLite is fine for zero-setup local development (no server to run).
# For staging/production, use PostgreSQL and run migrations first:
#   cd backend && alembic upgrade head
# DATABASE_URL=postgresql://acewin_app:REPLACE_ME@localhost:5432/acewin_crm
DATABASE_URL=sqlite:///./crm.db

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Platform Admin (cross-tenant super-admin panel) --------------------
# Comma-separated list of email addresses that get the cross-tenant
# Platform Admin panel (/platform-admin in the frontend), regardless of
# which organization their account belongs to. Register a normal
# account first, then put that same email here and restart the backend.
# Leave empty (default) to disable the panel entirely.
PLATFORM_ADMIN_EMAILS=ali@acewin.ir

# --- Admin notification email (SMTP) -------------------------------------
# Every meaningful user action and every support request (see
# app/routers/support_requests.py) is mirrored as an email to whoever's in
# ADMIN_NOTIFICATION_EMAILS (falls back to PLATFORM_ADMIN_EMAILS if left
# empty). Leave SMTP_HOST empty (default) to skip sending -- notifications
# are still logged and, more importantly, still show up in the Platform
# Admin panel's "Requests" tab, so no SMTP server is required for local dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@acewin.ir
ADMIN_NOTIFICATION_EMAILS=

# --- ACEWIN Copilot (Layer 2) --------------------------------------------
# Provider-agnostic AI configuration. Leave AI_PROVIDER=none to run the
# Copilot in architecture-only mode (no network calls, no key required).
#
# Adding/switching providers is a config-only change -- no code, no CRM
# changes, no frontend changes. Just set these three lines and restart
# the backend. Supported AI_PROVIDER values, with an example AI_MODEL:
#
#   AI_PROVIDER=openai       AI_MODEL=gpt-4o-mini          (api.openai.com)
#   AI_PROVIDER=openrouter   AI_MODEL=openai/gpt-4o-mini    (openrouter.ai -- one key, many models)
#   AI_PROVIDER=avalai       AI_MODEL=gpt-4o-mini           (api.avalai.ir -- recommended from Iran)
#   AI_PROVIDER=gapgpt       AI_MODEL=gpt-4o-mini           (api.gapgpt.app -- OpenAI/Gemini/Claude from Iran)
#   AI_PROVIDER=groq         AI_MODEL=llama-3.3-70b-versatile (api.groq.com -- fast open-model inference)
#   AI_PROVIDER=gemini       AI_MODEL=gemini-2.5-flash      (Google Generative Language API)
#   AI_PROVIDER=claude       AI_MODEL=claude-sonnet-4-6     (Anthropic Messages API)
#   AI_PROVIDER=custom       AI_MODEL=<required>             (any other OpenAI-compatible endpoint; AI_BASE_URL required)
#
# Leave AI_MODEL blank to use each provider's built-in default model
# (see DEFAULT_MODEL in backend/app/ai/client.py) -- except for "custom",
# where both AI_MODEL and AI_BASE_URL are mandatory.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
# Optional endpoint override (e.g. a self-hosted/proxy URL). Mandatory
# when AI_PROVIDER=custom; ignored/optional for every other provider.
AI_BASE_URL=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024
