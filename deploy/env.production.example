# Copy to .env on the Ubuntu server. Never commit the resulting .env file.
POSTGRES_USER=acewin_app
POSTGRES_PASSWORD=replace-with-a-strong-unique-password
POSTGRES_DB=acewin_crm
SECRET_KEY=replace-with-a-64-character-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=https://acewin-group.top,https://www.acewin-group.top
PLATFORM_ADMIN_EMAILS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@acewin-group.top
ADMIN_NOTIFICATION_EMAILS=
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024
BACKEND_HOST_BIND=127.0.0.1
BACKEND_HOST_PORT=8000
FRONTEND_HOST_BIND=127.0.0.1
FRONTEND_HOST_PORT=8080
VITE_API_URL=
