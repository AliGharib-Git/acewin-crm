# ─────────────────────────────────────────────────────────────────────────
# docker-compose environment. Copy this file to `.env` (same directory as
# docker-compose.yml) and adjust before running `docker compose up -d`.
# `.env` is git-ignored / docker-ignored on purpose — never commit real
# secrets.
# ─────────────────────────────────────────────────────────────────────────

# --- Postgres (the "db" service) -----------------------------------------
POSTGRES_USER=acewin_app
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=acewin_crm
# Only exposed on the host if you actually need to reach Postgres directly
# (e.g. with a local psql/GUI client). Leave commented out otherwise —
# backend<->db traffic stays inside the compose network regardless.
# POSTGRES_HOST_PORT=5432

# Comma-separated origins allowed to call the API directly (i.e. bypassing
# the frontend's nginx proxy) — browser docs/testing against
# http://localhost:${BACKEND_HOST_PORT} being the main case. Requests that
# go through the frontend's nginx proxy are same-origin and unaffected by
# this setting.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Backend API (the "backend" service) ----------------------------------
# Generate a real value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated allowlist of emails that get the cross-tenant Platform
# Admin panel. Register the account first, then list its email here.
PLATFORM_ADMIN_EMAILS=

# Outbound admin-notification email (SMTP). Leave SMTP_HOST empty to run
# with notifications logged only — no SMTP server required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@acewin.ir
ADMIN_NOTIFICATION_EMAILS=

# ACEWIN Copilot (Layer 2) — provider-agnostic AI config. AI_PROVIDER=none
# runs Copilot in architecture-only mode: no network calls, no key needed.
# See backend/.env.example for the full list of supported providers.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024

# Keep Docker-published ports on loopback in production. The host Nginx
# reverse proxy is the only public entry point.
BACKEND_HOST_BIND=127.0.0.1
# Host port the API is published on (container always listens on 8000).
BACKEND_HOST_PORT=8000

# --- Frontend (the "frontend" service) ------------------------------------
FRONTEND_HOST_BIND=127.0.0.1
# Host port the web UI is published on (container always listens on 80).
FRONTEND_HOST_PORT=8080

# Baked into the JS bundle at BUILD time (see frontend/Dockerfile). Leave
# empty so the frontend calls its own origin's /api/* — nginx proxies that
# to the backend service, so this only needs to change if the frontend is
# served from a different origin than the API.
VITE_API_URL=
